<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp">

    <Button
        android:text="实验1：线性布局"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="openLinear"
        android:layout_marginBottom="8dp" />

    <Button
        android:text="实验2：表格布局"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="openTable"
        android:layout_marginBottom="8dp" />

    <Button
        android:text="实验3：约束布局-计算器"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="openCalculator"
        android:layout_marginBottom="8dp" />

    <Button
        android:text="实验4：约束布局-太空旅行"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="openSpaceTravel"
        android:layout_marginBottom="8dp" />

    <Button
        android:text="实验5：Compose任务管理"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="openCompose" />

</LinearLayout>
